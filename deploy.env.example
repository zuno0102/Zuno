# Copy to .env.deploy (gitignored) and fill in. Read by deploy.ps1.

# Render -> zuno-api -> Settings -> Deploy Hook. Anyone with this URL can redeploy the API: keep it secret.
RENDER_DEPLOY_HOOK_URL=

# Neon, in Npgsql format. Only needed when a deploy contains new database migrations.
# Host=<endpoint>.neon.tech;Database=neondb;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
NEON_CONNECTION_STRING=

# Vercel, as the Zuno account: Account Settings -> Tokens, scoped to Zuno_team. Keep it secret.
# VERCEL_SCOPE is the team's slug (from its dashboard URL); VERCEL_PROJECT defaults to "zuno".
VERCEL_TOKEN=
VERCEL_SCOPE=
VERCEL_PROJECT=zuno

# The live API the web build talks to.
API_BASE_URL=https://zuno-api-qon8.onrender.com
