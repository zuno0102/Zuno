<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      The same secrets store as the Service and Rent APIs, so on a developer's machine both read one JWT
      signing key: a token from the shared login is valid here without copying secrets around.
    -->
    <UserSecretsId>4e5c30fb-10fa-4613-a907-38ad9e1b98d5</UserSecretsId>

    <!--
      A faster start: a server that slept while idle wakes on its first request, so every second of
      start-up is a second the user waits. Marketplace formats nothing by culture (numbers are read
      and written invariant), so it needs no culture data to load.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zuno.Marketplace.Application\Zuno.Marketplace.Application.csproj" />
    <ProjectReference Include="..\Zuno.Marketplace.Infrastructure\Zuno.Marketplace.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zuno.Marketplace.IntegrationTests" />
  </ItemGroup>

</Project>
