{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MarketplaceDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true,
    "MaxPoolSize": 20
  },
  "JwtSettings": {
    "Issuer": "Zuno.Api",
    "Audience": "Zuno.Client",
    "SigningKey": ""
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicPath": "/uploads",
    "MaxFileSizeBytes": 5242880
  },
  "Marketplace": {
    "MaxPrice": 1000000000,
    "MaxQuantity": 1000000,
    "ImageSlots": 5,
    "MaxFoodOfferHours": 24,
    "MaxAdDays": 60,
    "MaxStartDaysAhead": 30,
    "DefaultPageSize": 30,
    "MaxPageSize": 100,
    "CategoryCacheSeconds": 600
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "UploadPermitLimit": 30
  },
  "ServiceApi": {
    "BaseUrl": "",
    "TimeoutSeconds": 8
  }
}
