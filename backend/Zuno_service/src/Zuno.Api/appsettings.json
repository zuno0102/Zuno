{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ZunoDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true,
    "MaxPoolSize": 30
  },
  "HiringPostCleanup": {
    "IntervalMinutes": 15,
    "BatchSize": 500
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicPath": "/uploads",
    "MaxFileSizeBytes": 5242880,
    "MaxVideoFileSizeBytes": 26214400,
    "PrivateRootPath": "private-uploads"
  },
  "PlatformSettings": {
    "RefreshSeconds": 60
  },
  "Vacancies": {
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "MaxRequirements": 15,
    "AllowedFileExtensions": [ "pdf", "jpg", "jpeg", "png" ],
    "MaxFileSizeBytes": 5242880,
    "MaxApplicationUploadBytes": 31457280
  },
  "JwtSettings": {
    "Issuer": "Zuno.Api",
    "Audience": "Zuno.Client",
    "SigningKey": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 14
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/zuno-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  }
}
